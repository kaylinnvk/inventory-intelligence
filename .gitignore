# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# =========================
# Jupyter / Kaggle
# =========================
.ipynb_checkpoints/

# =========================
# Streamlit
# =========================
.streamlit/secrets.toml

# =========================
# Data
# =========================

# Raw datasets should not be committed
data/raw/
*.csv

# Ignore processed data by default
data/processed/*

# Keep directory
!data/processed/.gitkeep

# Dashboard data required for deployment
!data/processed/daily_summary.parquet
!data/processed/product_catalog.parquet
!data/processed/streamlit_forecast_output.parquet
!data/processed/m5_dashboard_clean.parquet

# Allow small mock datasets if needed
!data/mock/
!data/mock/**

# =========================
# Model artifacts
# =========================
models/
*.pkl
*.pickle
*.joblib

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# IDE
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs / temporary files
# =========================
*.log
*.tmp